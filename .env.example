# Copy to .env (never commit) or set these in your host's environment settings.
NEXUS_DEMO_MODE=1                 # 1 = create demo accounts + show them on the login page; set 0 for real use
NEXUS_ADMIN_PASSWORD=             # used when NEXUS_DEMO_MODE=0 on a fresh database (else a random one is printed once)
NEXUS_DB_PATH=/data/nexus.db      # put this on a persistent disk / volume
NEXUS_BACKUP_DIR=/data/backups
NEXUS_SESSION_IDLE_MINUTES=30
NEXUS_SESSION_MAX_HOURS=12
NEXUS_ALLOWED_EMAIL_DOMAINS=      # e.g. aicte-india.org (comma separated); empty = any
# Email verification (without SMTP the code is shown on screen in demo mode)
NEXUS_SMTP_HOST=
NEXUS_SMTP_PORT=587
NEXUS_SMTP_USER=
NEXUS_SMTP_PASSWORD=
NEXUS_SMTP_FROM=no-reply@your-domain.example
# Optional external AI phrasing (off by default in the app, opt-in per session)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
